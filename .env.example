# ============================================
# 数据库配置
# ============================================

# PostgreSQL 连接字符串（使用 Docker Compose 时）
# 格式: postgresql://用户名:密码@主机:端口/数据库名
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/intelligent_knowledge_base"

# 或者使用 SQLite（轻量级替代方案，无需 Docker）
# 取消下面这行的注释，并注释掉上面的 DATABASE_URL
# DATABASE_URL="file:./dev.db"

# ============================================
# PostgreSQL 单独配置（用于 Docker Compose）
# ============================================
DB_USER="postgres"
DB_PASSWORD="postgres"
DB_NAME="intelligent_knowledge_base"
DB_PORT="5432"
DB_HOST="localhost"

# ============================================
# DashScope（阿里云灵积）API 配置
# ============================================
# 用于 Embedding 向量化和 LLM 对话
# 获取 API Key: https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY="your-dashscope-api-key-here"

# Embedding 模型配置
# 可选模型: text-embedding-v1, text-embedding-v2, text-embedding-v3
# text-embedding-v2 推荐用于中文场景，维度 1536
EMBEDDING_MODEL="text-embedding-v2"

# LLM 模型配置
# 可选模型: qwen-turbo, qwen-plus, qwen-max, qwen-7b-chat, qwen-14b-chat 等
# qwen-plus: 平衡性能与速度
# qwen-max: 最强能力，较慢
LLM_MODEL="qwen-plus"

# LLM 温度参数（0-2），越低越确定，越高越随机
LLM_TEMPERATURE="0.7"
