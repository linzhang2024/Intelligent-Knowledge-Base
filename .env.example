# ============================================
# 数据库配置
# ============================================

# PostgreSQL 连接字符串（使用 Docker Compose 时）
# 格式: postgresql://用户名:密码@主机:端口/数据库名
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/intelligent_knowledge_base"

# 或者使用 SQLite（轻量级替代方案，无需 Docker）
# 取消下面这行的注释，并注释掉上面的 DATABASE_URL
# DATABASE_URL="file:./dev.db"

# ============================================
# PostgreSQL 单独配置（用于 Docker Compose）
# ============================================
DB_USER="postgres"
DB_PASSWORD="postgres"
DB_NAME="intelligent_knowledge_base"
DB_PORT="5432"
DB_HOST="localhost"

# ============================================
# 向量检索配置
# ============================================

# Chroma 向量数据库连接地址
# 本地运行时使用 http://localhost:8000
CHROMA_URL="http://localhost:8000"

# DeepSeek API 密钥
# 用于生成文本嵌入向量
# 请从 https://platform.deepseek.com/ 获取 API Key
DEEPSEEK_API_KEY="your-deepseek-api-key-here"
